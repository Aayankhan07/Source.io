# Secrets for running edge functions locally:
#   supabase functions serve <name> --env-file supabase/functions/.env
#
# In a deployed project these are set with `supabase secrets set`, NOT from this file.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by the
# platform when deployed — you only need them here for local serving.

# Groq: Whisper transcription + llama chat completions
GROQ_API_KEY=your-groq-api-key

# Comma-separated list of browser origins allowed by CORS. Unset or "*" allows any origin
# (never echoed). Set this in production.
ALLOWED_ORIGIN=https://sourceio.app,http://localhost:3000

# Lemon Squeezy webhook signing secret. Required: billing-webhook refuses all events without it.
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret

# Local serving only — copy from your Supabase project settings.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini (OpenAI-compatible endpoint) for long documents (> ~7 pages). Optional: without it,
# long documents run section by section on Groq. Free tier inputs may be used by Google.
GEMINI_API_KEY=your-gemini-api-key

# AES-256-GCM master key for users' saved API keys (base64, 32 bytes): `openssl rand -base64 32`.
# Required for saving/using stored keys. Rotating it makes existing saved keys unreadable (users re-save).
BYOK_ENCRYPTION_KEY=

# Optional: per-run time budget for section-by-section notes, in ms (default 120000).
NOTES_TIME_BUDGET_MS=120000
