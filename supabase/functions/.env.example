# Secrets for running edge functions locally:
#   supabase functions serve <name> --env-file supabase/functions/.env
#
# In a deployed project these are set with `supabase secrets set`, NOT from this file.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by the
# platform when deployed — you only need them here for local serving.

# Groq: Whisper transcription + llama chat completions
GROQ_API_KEY=your-groq-api-key

# Optional. Restricts browser CORS access to a single origin. Defaults to "*".
ALLOWED_ORIGIN=http://localhost:8080

# Local serving only — copy from your Supabase project settings.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
