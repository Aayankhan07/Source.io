# Copy to .env.local and fill in your Supabase project values.
# Both are public, browser-safe values (the anon/publishable key, never the service role key).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Canonical public origin, used for metadataBase (app/layout.tsx) and app/sitemap.ts.
# Defaults to https://sourceio.app when unset.
NEXT_PUBLIC_SITE_URL=https://sourceio.app

# --- Error tracking (Sentry) — all optional ---------------------------------
# Sentry is completely disabled unless NEXT_PUBLIC_SENTRY_DSN is set.
# The DSN is public (it ships in the browser bundle).
NEXT_PUBLIC_SENTRY_DSN=

# Build-time only, for uploading source maps. Set these in CI / Vercel, never
# in a committed file. Source maps are uploaded only when SENTRY_AUTH_TOKEN is present.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- E2E tests (optional, local/CI only) ------------------------------------
# tests/e2e/journey.spec.ts is skipped unless both are set. Use a dedicated test
# account with fewer than 3 saved documents.
# E2E_USER_EMAIL=
# E2E_USER_PASSWORD=

# --- Product analytics (PostHog) — optional ---------------------------------
# Analytics is a complete no-op unless NEXT_PUBLIC_POSTHOG_KEY is set (posthog-js
# is not even downloaded). Use https://eu.i.posthog.com for an EU project.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Contact address shown on the privacy, terms and refunds pages.
NEXT_PUBLIC_CONTACT_EMAIL=support@sourceio.app
